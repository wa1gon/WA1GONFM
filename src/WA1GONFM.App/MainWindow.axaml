<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WA1GONFM.App.MainWindow" Title="WA1GONFM" Width="1120" Height="720" MinWidth="750" MinHeight="480">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="Background" Value="{DynamicResource FmInactiveTab}"/>
      <Setter Property="Foreground" Value="{DynamicResource FmText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FmAccent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Margin" Value="2,2,3,0"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource FmActiveTab}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="2,2,2,0"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource FmBackground}">
    <Border Grid.Row="0" Background="{DynamicResource FmToolbar}" Padding="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="←" Click="Back_Click" ToolTip.Tip="Back"/>
        <Button Content="→" Click="Forward_Click" ToolTip.Tip="Forward"/>
        <Button Content="↑" Click="Up_Click" ToolTip.Tip="Parent folder"/>
        <ToggleButton x:Name="HomeRootToggle" Content="Home / Root" Checked="HomeRoot_Changed" Unchecked="HomeRoot_Changed" ToolTip.Tip="Switch active tab between Home and /"/>
        <TextBox x:Name="PathBox" Width="310" Watermark="Directory path" KeyDown="PathBox_KeyDown"/>
        <ToggleButton x:Name="HiddenToggle" Content="Hidden" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
        <ToggleButton x:Name="DirectoriesToggle" Content="Folders" IsChecked="True" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
        <Button Content="New Folder" Click="NewFolder_Click" ToolTip.Tip="Create directory in active tab"/>
        <Button Content="Terminal" Click="Terminal_Click"/>
        <Button Content="Settings" Click="Settings_Click"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource FmSurface}" Padding="8,5"><TextBlock x:Name="StatusText" Foreground="{DynamicResource FmText}" Text="Ready"/></Border>
    <Grid Grid.Row="2" ColumnDefinitions="260,5,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,155,Auto,*" Margin="10,10,4,10">
        <DockPanel><TextBlock Text="SHORTCUTS" FontWeight="Bold" Foreground="{DynamicResource FmAccent}" VerticalAlignment="Center"/><Button Content="+" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="AddShortcut_Click"/></DockPanel>
        <ListBox Grid.Row="1" x:Name="ShortcutsList" DoubleTapped="Shortcut_DoubleTapped"/>
        <TextBlock Grid.Row="2" Text="DIRECTORIES  /" FontWeight="Bold" Foreground="{DynamicResource FmAccent}" Margin="0,12,0,8"/>
        <TreeView Grid.Row="3" x:Name="DirectoryTree" SelectionChanged="Tree_SelectionChanged">
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsVisible" Value="{Binding IsReal}"/>
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></TreeDataTemplate></TreeView.ItemTemplate>
        </TreeView>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource FmToolbar}"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="6,10,10,10">
        <DockPanel Background="{DynamicResource FmSurface}"><Button Content="+ New Tab" DockPanel.Dock="Right" Click="NewTab_Click"/><TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" HorizontalAlignment="Stretch"/></DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,5">
          <Button Content="Details" Click="DetailsView_Click" ToolTip.Tip="Details (Ctrl+1)"/>
          <Button Content="Icons" Click="IconView_Click" ToolTip.Tip="Icons with automatic image previews (Ctrl+2)"/>
          <Button Content="Compact" Click="CompactView_Click" ToolTip.Tip="Compact (Ctrl+3)"/>
          <TextBlock x:Name="ViewModeLabel" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
        <Grid.ContextMenu>
          <ContextMenu>
              <MenuItem Header="Open" Click="OpenSelected_Click"/>
              <MenuItem Header="Open With..." Click="OpenWith_Click"/>
              <Separator/>
              <MenuItem Header="Cut" Click="Cut_Click"/>
              <MenuItem Header="Copy" Click="Copy_Click"/>
              <MenuItem Header="Paste" Click="Paste_Click"/>
              <MenuItem Header="Rename" Click="Rename_Click"/>
              <Separator/>
              <MenuItem Header="Move to Trash" Click="Trash_Click"/>
              <MenuItem Header="Delete Permanently" Click="PermanentDelete_Click"/>
              <MenuItem Header="Properties" Click="Properties_Click"/>
              <Separator/>
              <MenuItem Header="New Folder" Click="NewFolder_Click"/>
              <MenuItem Header="Refresh" Click="Refresh_Click"/>
              <MenuItem Header="Open Terminal Here" Click="Terminal_Click"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <ListBox x:Name="FilesList" Background="{DynamicResource FmSurface}" DoubleTapped="Files_DoubleTapped" KeyDown="Files_KeyDown" PointerPressed="Files_PointerPressed" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="32,*,110,120,170" Margin="3,2">
                <TextBlock Grid.Column="0" Text="{Binding Glyph}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}"/>
                <TextBlock Grid.Column="3" Text="{Binding TypeText}"/>
                <TextBlock Grid.Column="4" Text="{Binding ModifiedText}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="IconFilesList" IsVisible="False" SelectionChanged="ViewSelection_Changed" DoubleTapped="Files_DoubleTapped" PointerPressed="Files_PointerPressed" KeyDown="Files_KeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="112" Margin="7" Spacing="5" HorizontalAlignment="Center">
                <Grid Width="80" Height="72">
                  <TextBlock Text="{Binding Glyph}" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                </Grid>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" MaxLines="2"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="CompactFilesList" IsVisible="False" SelectionChanged="ViewSelection_Changed" DoubleTapped="Files_DoubleTapped" PointerPressed="Files_PointerPressed" KeyDown="Files_KeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Width="220" Spacing="6" Margin="4,2">
                <TextBlock Text="{Binding Glyph}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Width="190"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>