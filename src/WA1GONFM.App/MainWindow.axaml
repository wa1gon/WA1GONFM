<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WA1GONFM.App.MainWindow" Title="filepilot" Icon="avares://filepilot/Assets/filepilot-256.png" DragDrop.AllowDrop="True" Width="1120" Height="720" MinWidth="750" MinHeight="480">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="Background" Value="{DynamicResource FmInactiveTab}"/>
      <Setter Property="Foreground" Value="{DynamicResource FmText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FmAccent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Margin" Value="2,2,3,0"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource FmActiveTab}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="2,2,2,0"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource FmBackground}" DragDrop.AllowDrop="True" DragDrop.DragOver="Files_DragOver" DragDrop.Drop="Files_Drop">
    <Border Grid.Row="0" Background="{DynamicResource FmToolbar}" Padding="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Click="Back_Click" ToolTip.Tip="Back (Alt+Left)"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M15 18 9 12 15 6 M9 12 H21" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <Button Click="Forward_Click" ToolTip.Tip="Forward (Alt+Right)"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M9 18 15 12 9 6 M15 12 H3" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <Button Click="Up_Click" ToolTip.Tip="Parent folder"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M18 15 12 9 6 15 M12 9 V21" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <ToggleButton x:Name="HomeRootToggle" IsCheckedChanged="HomeRoot_Changed" ToolTip.Tip="Switch between Home and filesystem root">
          <StackPanel Orientation="Horizontal" Spacing="5"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 10 12 3 21 10 M5 9 V21 H19 V9 M9 21 V14 H15 V21" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="/" VerticalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <TextBox x:Name="PathBox" Width="310" PlaceholderText="Directory path" KeyDown="PathBox_KeyDown"/>
        <ToggleButton x:Name="HiddenToggle" IsCheckedChanged="Filters_Changed" ToolTip.Tip="Show hidden files">
          <Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M2 12 S6 5 12 5 S22 12 22 12 S18 19 12 19 S2 12 2 12 M10 12 A2 2 0 1 0 14 12 A2 2 0 1 0 10 12" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
        </ToggleButton>
        <ToggleButton x:Name="DirectoriesToggle" IsChecked="True" IsCheckedChanged="Filters_Changed" ToolTip.Tip="Show directories">
          <Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 7 V19 H21 V7 H12 L10 4 H3 Z" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
        </ToggleButton>
        <Button Click="NewFolder_Click" ToolTip.Tip="New folder"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 7 V19 H21 V7 H12 L10 4 H3 Z M12 10 V17 M8.5 13.5 H15.5" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <Button Click="Refresh_Click" ToolTip.Tip="Refresh"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M20 7 V3 L16 7 H20 C18 3 14 2 10 3 C6 4 4 7 4 10 M4 17 V21 L8 17 H4 C6 21 10 22 14 21 C18 20 20 17 20 14" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <Button Click="Terminal_Click" ToolTip.Tip="Open terminal here"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 5 H21 V19 H3 Z M7 9 10 12 7 15 M12 15 H17" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
        <Button Click="Settings_Click" ToolTip.Tip="Settings"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M12 3 V6 M12 18 V21 M3 12 H6 M18 12 H21 M5.6 5.6 7.8 7.8 M16.2 16.2 18.4 18.4 M18.4 5.6 16.2 7.8 M7.8 16.2 5.6 18.4 M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource FmSurface}" Padding="8,5"><TextBlock x:Name="StatusText" Foreground="{DynamicResource FmText}" Text="Ready"/></Border>
    <Grid Grid.Row="2" ColumnDefinitions="260,5,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,155,Auto,*" Margin="10,10,4,10">
        <DockPanel><TextBlock Text="SHORTCUTS" FontWeight="Bold" Foreground="{DynamicResource FmAccent}" VerticalAlignment="Center"/><Button Content="+" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="AddShortcut_Click" ToolTip.Tip="Add shortcut"/></DockPanel>
        <ListBox Grid.Row="1" x:Name="ShortcutsList" Tapped="Shortcut_Tapped" DoubleTapped="Shortcut_DoubleTapped" PointerPressed="Shortcut_PointerPressed">
          <ListBox.ContextMenu>
            <ContextMenu><MenuItem Header="Remove Shortcut" Click="RemoveShortcut_Click"/></ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
        <TextBlock Grid.Row="2" Text="DIRECTORIES  /" FontWeight="Bold" Foreground="{DynamicResource FmAccent}" Margin="0,12,0,8"/>
        <TreeView Grid.Row="3" DragDrop.AllowDrop="True" DragDrop.DragOver="Tree_DragOver" DragDrop.Drop="Tree_Drop" x:Name="DirectoryTree" SelectionChanged="Tree_SelectionChanged">
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsVisible" Value="{Binding IsReal}"/>
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></TreeDataTemplate></TreeView.ItemTemplate>
        </TreeView>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource FmToolbar}"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="6,10,10,10">
        <DockPanel Background="{DynamicResource FmSurface}"><Button Content="+ New Tab" DockPanel.Dock="Right" Click="NewTab_Click" ToolTip.Tip="New tab"/><TabControl x:Name="Tabs" DragDrop.AllowDrop="True" DragDrop.DragOver="Tabs_DragOver" DragDrop.Drop="Tabs_Drop" SelectionChanged="Tabs_SelectionChanged" HorizontalAlignment="Stretch"/></DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,5">
          <Button Click="DetailsView_Click" ToolTip.Tip="Details (Ctrl+1)"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M4 5 H20 M4 10 H20 M4 15 H20 M4 20 H20" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
          <Button Click="IconView_Click" ToolTip.Tip="Icons with automatic image previews (Ctrl+2)"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
          <Button Click="CompactView_Click" ToolTip.Tip="Compact (Ctrl+3)"><Viewbox Width="19" Height="19" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 4 H10 V8 H3 Z M14 4 H21 V8 H14 Z M3 11 H10 V15 H3 Z M14 11 H21 V15 H14 Z M3 18 H10 V22 H3 Z M14 18 H21 V22 H14 Z" Stroke="{DynamicResource FmText}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/></Canvas></Viewbox></Button>
          <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <ComboBox x:Name="SortBy" Width="135" SelectionChanged="Sort_Changed"/>
          <CheckBox x:Name="SortDescending" Content="Descending" VerticalAlignment="Center" IsCheckedChanged="Sort_Changed"/>
          <CheckBox x:Name="FoldersFirst" Content="Folders first" VerticalAlignment="Center" IsCheckedChanged="Sort_Changed"/>
          <TextBlock x:Name="ViewModeLabel" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
        <Grid.ContextMenu>
          <ContextMenu>
              <MenuItem Header="Open" Click="OpenSelected_Click"/>
              <MenuItem Header="Open With..." Click="OpenWith_Click"/>
              <Separator/>
              <MenuItem Header="Cut" Click="Cut_Click"/>
              <MenuItem Header="Copy" Click="Copy_Click"/>
              <MenuItem Header="Paste" Click="Paste_Click"/>
              <MenuItem Header="Rename" Click="Rename_Click"/>
              <Separator/>
              <MenuItem Header="Move to Trash" Click="Trash_Click"/>
              <MenuItem Header="Delete Permanently" Click="PermanentDelete_Click"/>
              <MenuItem Header="Properties" Click="Properties_Click"/>
              <Separator/>
              <MenuItem Header="New Folder" Click="NewFolder_Click"/>
              <MenuItem Header="Refresh" Click="Refresh_Click"/>
              <MenuItem Header="Open Terminal Here" Click="Terminal_Click"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid RowDefinitions="Auto,*" IsVisible="True" x:Name="DetailsContainer">
          <Grid Grid.Row="0" ColumnDefinitions="32,*,110,120,170" Margin="3,2">
            <Button Grid.Column="1" Content="Name" Tag="Name" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortHeader_Click"/>
            <Button Grid.Column="2" Content="Size" Tag="Size" Click="SortHeader_Click"/>
            <Button Grid.Column="3" Content="Type" Tag="Type" Click="SortHeader_Click"/>
            <Button Grid.Column="4" Content="Modified" Tag="Date modified" Click="SortHeader_Click"/>
          </Grid>
        <ListBox Grid.Row="1" x:Name="FilesList" SelectionMode="Multiple" PointerReleased="Files_PointerReleased" Background="{DynamicResource FmSurface}" Tapped="Files_Tapped" DoubleTapped="Files_DoubleTapped" KeyDown="Files_KeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="32,*,110,120,170" Margin="3,2">
                <TextBlock Grid.Column="0" Text="{Binding Glyph}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}"/>
                <TextBlock Grid.Column="3" Text="{Binding TypeText}"/>
                <TextBlock Grid.Column="4" Text="{Binding ModifiedText}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        <ListBox x:Name="IconFilesList" SelectionMode="Multiple" PointerReleased="Files_PointerReleased" IsVisible="False" SelectionChanged="ViewSelection_Changed" Tapped="Files_Tapped" DoubleTapped="Files_DoubleTapped" KeyDown="Files_KeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="112" Margin="7" Spacing="5" HorizontalAlignment="Center">
                <Grid Width="80" Height="72">
                  <TextBlock Text="{Binding Glyph}" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                </Grid>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" MaxLines="2"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="CompactFilesList" SelectionMode="Multiple" PointerReleased="Files_PointerReleased" IsVisible="False" SelectionChanged="ViewSelection_Changed" Tapped="Files_Tapped" DoubleTapped="Files_DoubleTapped" KeyDown="Files_KeyDown" DragDrop.AllowDrop="True" DragDrop.Drop="Files_Drop" DragDrop.DragOver="Files_DragOver">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Width="220" Spacing="6" Margin="4,2">
                <TextBlock Text="{Binding Glyph}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Width="190"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>